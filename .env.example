# Docker Compose 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

# 对外访问端口
WEB_PORT=3000
SERVER_PORT=8080

# MySQL
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=kenaito_conf
MYSQL_USER=kenaito
MYSQL_PASSWORD=kenaito123

# 后端 JWT
JWT_SECRET=kenaito-conf-docker-secret-change-me
JWT_EXPIRE_HOURS=24

# 时区
TZ=Asia/Shanghai
