FROM node:18-alpine

WORKDIR /app

COPY kenaito-conf-nodejs-client/ ./kenaito-conf-nodejs-client/
COPY kenaito-conf-nodejs-client-demo/ ./kenaito-conf-nodejs-client-demo/

WORKDIR /app/kenaito-conf-nodejs-client-demo
RUN npm install ../kenaito-conf-nodejs-client && npm install

EXPOSE 8083
CMD ["node", "app.js"]
