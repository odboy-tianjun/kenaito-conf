# Build stage
FROM registry.cn-shanghai.aliyuncs.com/odboy/kenaito-cicd:runtime-maven3-jdk21 AS build

WORKDIR /src

# Copy client library and install to local Maven repo
COPY kenaito-conf-springboot2-client/ ./kenaito-conf-springboot2-client/
WORKDIR /src/kenaito-conf-springboot2-client
RUN mvn clean install -DskipTests

# Copy demo project and build
WORKDIR /src
COPY kenaito-conf-springboot2-client-demo/ ./kenaito-conf-springboot2-client-demo/
WORKDIR /src/kenaito-conf-springboot2-client-demo
RUN mvn clean package -DskipTests

# Runtime stage
FROM registry.cn-shanghai.aliyuncs.com/odboy/kenaito-cicd:runtime-jdk8

WORKDIR /app
COPY --from=build /src/kenaito-conf-springboot2-client-demo/target/*.jar app.jar

EXPOSE 8081

ENTRYPOINT ["java", "-jar", "app.jar"]
